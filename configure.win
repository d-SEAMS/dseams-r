#!/bin/sh
# src/Makevars.win is static. A source package carries src/seams. In a git
# checkout tools/vendor.sh makes it from SEAMS_CORE_SRC (or DSEAMS_ROOT),
# else from the revision pinned in tools/seams-core.ref, as for configure.
if [ -f src/seams/seams_lang.cpp ] && [ -f inst/extdata/ice1h.lammpstrj ]; then
  exit 0
fi
if [ ! -f tools/vendor.sh ]; then
  echo "configure.win: src/seams is missing and there is no tools/vendor.sh to make it" >&2
  exit 1
fi
sh tools/vendor.sh
