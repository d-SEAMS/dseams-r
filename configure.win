#!/bin/sh
# src/Makevars.win is static. A source package carries the vendored tree.
# In a git checkout tools/vendor.sh makes whatever tools/vendored-sentinels
# is missing, the same list configure reads.
#
# Windows builds the bundled engine only. configure selects a linked engine
# with these variables; here either one is an error, before R or the
# vendored tree is used.
case "${DSEAMS_SYSTEM_ENGINE:-}" in
  1|yes|true|TRUE)
    echo "configure.win: DSEAMS_SYSTEM_ENGINE is set, but Windows supports only the bundled build. Unset DSEAMS_SYSTEM_ENGINE." >&2
    exit 1
    ;;
esac
if [ -n "${SEAMS_LIBDIR:-}" ]; then
  echo "configure.win: SEAMS_LIBDIR is set, but Windows supports only the bundled build. Unset SEAMS_LIBDIR." >&2
  exit 1
fi
: "${R_HOME:=$(R RHOME)}"
if [ ! -x "${R_HOME}/bin/R" ]; then
  echo "configure.win: could not find R under R_HOME=${R_HOME}" >&2
  exit 1
fi

version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
sh tools/ensure-vendored.sh configure.win || exit 1
. ./tools/bundled-tools.sh
require_makevars_win_version . "${version}" configure.win || exit 1
discover_reader_tools
require_reader_tools configure.win
sh tools/vendored-tree.sh --require-checksum configure.win || exit 1

# readcon-core is built for RUST_TARGET when it is set, else for the GNU
# target of the C compiler. src/Makevars.win reads the choice from
# src/rust-target.mk, and that target's standard library has to be
# installed beside rustc.
if [ -n "${RUST_TARGET:-}" ]; then
  rust_target=${RUST_TARGET}
else
  cc=$("${R_HOME}/bin/R" CMD config CC)
  case "$(${cc} -dumpmachine 2>/dev/null)" in
    aarch64*) rust_target=aarch64-pc-windows-gnullvm ;;
    *) rust_target=x86_64-pc-windows-gnu ;;
  esac
fi
libdir=$(rustc --print target-libdir --target "${rust_target}" 2>/dev/null)
found=
if [ -n "${libdir}" ] && [ -d "${libdir}" ]; then
  for f in "${libdir}"/libstd-*.rlib; do
    if [ -f "${f}" ]; then
      found=1
    fi
  done
fi
if [ -z "${found}" ]; then
  echo "configure.win: the Rust standard library for ${rust_target} is not installed; run: rustup target add ${rust_target}" >&2
  exit 1
fi
cargo_name=$(make_tool_name "${CARGO}" configure.win) || exit 1
cmake_name=$(make_tool_name "${CMAKE}" configure.win) || exit 1
objcopy_name=$(make_tool_name "${OBJCOPY}" configure.win) || exit 1
{
  printf 'RUST_TARGET ?= %s\n' "${rust_target}"
  printf 'CARGO ?= %s\n' "${cargo_name}"
  printf 'CMAKE ?= %s\n' "${cmake_name}"
  printf 'OBJCOPY ?= %s\n' "${objcopy_name}"
} > src/rust-target.mk
echo "configure.win: readcon-core builds for ${rust_target}"
