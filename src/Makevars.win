CXX_STD = CXX20

PKG_CPPFLAGS = -I. -Iseams -Iseams/include -Ireadcon-core/include -Ichemfiles-install/include -DSEAMS_STATIC -DSEAMS_LANG_VERSION='"2.14.1"' -DSEAMS_HAS_OPENMP=1 -DSEAMS_HAS_READCON=1 -DSEAMS_HAS_CHEMFILES=1 -DSEAMS_CHEMFILES_PATCHED=1
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) readcon-core/target/release/libreadcon_core.a chemfiles-install/lib/libchemfiles.a -lws2_32 -luserenv -lbcrypt -lntdll -ldbghelp -lsynchronization -lpthread

CARGO = cargo
CMAKE = cmake
OBJCOPY = objcopy
CHEMFILES_BUILD = $(TEMP)/dseams-chemfiles-build
READER_DEPS = readcon-core/target/release/libreadcon_core.a chemfiles-install/lib/libchemfiles.a

# R links with the Rtools MinGW toolchain. Cargo's host target can be
# MSVC, whose staticlib is readcon_core.lib, so the crate is built for
# the GNU target of the C compiler and copied to the path PKG_LIBS
# names. configure.win checks that this target's std is installed.
# Recursive, so $(CC) is read after Makeconf defines it.
RUST_TARGET = $(if $(findstring aarch64,$(shell $(CC) -dumpmachine)),aarch64-pc-windows-gnullvm,x86_64-pc-windows-gnu)

# The same engine objects as src/Makevars.in; tools/vendor.sh checks that
# the two lists agree.
SEAMS_OBJECTS = \
  seams/seams_lang.o \
  seams/absOrientation.o \
  seams/bond.o \
  seams/bop.o \
  seams/brine_front.o \
  seams/cage_affiliation.o \
  seams/cage_canon.o \
  seams/cage_enum.o \
  seams/cage_pack.o \
  seams/chemfiles_io.o \
  seams/chill_plus_scheme.o \
  seams/chordless.o \
  seams/cluster.o \
  seams/cutoff_csr.o \
  seams/density.o \
  seams/diamond_cna.o \
  seams/franzblau.o \
  seams/generic.o \
  seams/ira_sofi.o \
  seams/lc_threads.o \
  seams/local_symmetry.o \
  seams/mol_sys.o \
  seams/neighbours.o \
  seams/order_parameter.o \
  seams/ozaki.o \
  seams/pntCorrespondence.o \
  seams/rdf.o \
  seams/rdf2d.o \
  seams/ring.o \
  seams/seams_api.o \
  seams/seams_c_api.o \
  seams/seams_input.o \
  seams/seams_output.o \
  seams/shapeMatch.o \
  seams/shell2_count.o \
  seams/shell_classify.o \
  seams/shell_kernel.o \
  seams/site.o \
  seams/steinhardt_parallel.o \
  seams/topo_bulk.o \
  seams/topo_fingerprint.o \
  seams/topo_neighbour_key.o \
  seams/topo_one_dim.o \
  seams/topo_two_dim.o \
  seams/tum_offload.o \
  seams/water_select.o \
  seams/ylm_cartesian.o

OBJECTS = cpp11.o dseams.o dseams_r_io.o seams_call.o $(SEAMS_OBJECTS)

# This target is first so it stays the default goal. A target earlier
# than `all` would be what `make` builds, and the shared library would
# never be linked.
all: $(SHLIB)

reader-stamp: $(READER_DEPS)
	@touch reader-stamp

$(OBJECTS): reader-stamp

# Cargo and CMake run at most two jobs, as CRAN's policy for Rust
# packages asks. The same policy has Cargo write nothing under the
# user's home, so CARGO_HOME is a directory inside the package.
CARGO_HOME_DIR = $(CURDIR)/readcon-core/cargo-home

readcon-core/target/release/libreadcon_core.a: readcon-core/Cargo.toml readcon-core/Cargo.lock
	rustc --version
	"$(CARGO)" --version
	find readcon-core/vendor -name cargo-checksum.json -exec sh -c \
	  'cp "$$1" "$$(dirname "$$1")/.cargo-checksum.json"' _ {} \;
	mkdir -p "$(CARGO_HOME_DIR)"
	CARGO_HOME="$(CARGO_HOME_DIR)" \
	  CARGO_PROFILE_RELEASE_LTO=off CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
	  CARGO_PROFILE_RELEASE_DEBUG=false \
	  CARGO_PROFILE_RELEASE_DEBUG_ASSERTIONS=false \
	  CARGO_PROFILE_RELEASE_OVERFLOW_CHECKS=false \
	  CFLAGS="$(CFLAGS) -DNDEBUG" CXXFLAGS="$(CXXFLAGS) -DNDEBUG" \
	  RUSTFLAGS="-C relocation-model=pic -A non_camel_case_types" \
	  "$(CARGO)" rustc -j 2 --offline --locked --release --lib --crate-type staticlib \
	    --target $(RUST_TARGET) \
	    --manifest-path readcon-core/Cargo.toml \
	    --config 'source.crates-io.replace-with="vendored-sources"' \
	    --config 'source.vendored-sources.directory="readcon-core/vendor"' \
	    --target-dir readcon-core/target
	rm -rf "$(CARGO_HOME_DIR)"
	cp readcon-core/target/$(RUST_TARGET)/release/libreadcon_core.a $@
	sh ../tools/reader-symbols.sh "$(OBJCOPY)" $@
	find readcon-core/vendor -name '.cargo-checksum.json' -delete

# On Windows CMake's default generator is Visual Studio when that is
# installed. The MinGW compilers named here need a Makefile generator.
chemfiles-install/lib/libchemfiles.a: chemfiles/CMakeLists.txt
	"$(CMAKE)" -G "Unix Makefiles" -S chemfiles -B "$(CHEMFILES_BUILD)" \
	  -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_INSTALL_PREFIX="$(CURDIR)/chemfiles-install" \
	  -DCMAKE_INSTALL_LIBDIR=lib \
	  -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
	  -DCMAKE_C_COMPILER="$(firstword $(CC))" \
	  -DCMAKE_CXX_COMPILER="$(firstword $(CXX))" \
	  -DCMAKE_C_FLAGS="-O2 -fPIC -w -DNDEBUG" \
	  -DCMAKE_CXX_FLAGS="-O2 -fPIC -w -DNDEBUG" \
	  -DCMAKE_C_FLAGS_RELEASE="-O2 -DNDEBUG" \
	  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -DNDEBUG" \
	  -DBUILD_SHARED_LIBS=OFF \
	  -DCHFL_BUILD_TESTS=OFF \
	  -DCHFL_BUILD_DOCUMENTATION=OFF \
	  -DCHFL_SYSTEM_ZLIB=OFF \
	  -DCHFL_SYSTEM_LZMA=OFF \
	  -DCHFL_SYSTEM_BZIP2=OFF
	"$(CMAKE)" --build "$(CHEMFILES_BUILD)" --parallel 2
	"$(CMAKE)" --install "$(CHEMFILES_BUILD)"
	rm -rf "$(CHEMFILES_BUILD)"
	sh ../tools/reader-symbols.sh "$(OBJCOPY)" $@
