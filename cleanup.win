#!/bin/sh
# R runs cleanup.win instead of cleanup. configure.win writes
# src/rust-target.mk. The build then writes object files and the reader
# directories. src/Makevars is removed as well, so a Unix configure in
# this tree does not leave its output behind. The set matches cleanup.
rm -f src/Makevars src/*.o src/*.so src/*.dll src/seams/*.o src/reader-stamp src/rust-target.mk
rm -rf src/readcon-core/target src/readcon-core/cargo-home src/chemfiles-build src/chemfiles-build.* src/chemfiles-install
