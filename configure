#!/bin/sh
# Write src/Makevars from src/Makevars.in.
#
# By default the engine is compiled from the copy of the seams-core sources
# in src/seams. A source package from R CMD build already holds that copy,
# so installing it uses no network. In a git checkout tools/vendor.sh makes
# src/seams from, in order:
#
#   SEAMS_CORE_SRC  a seams-core source tree (DSEAMS_ROOT is read too)
#   tools/seams-core.ref  the pinned revision, downloaded from GitHub by
#                   tools/fetch-engine.R; DSEAMS_NO_DOWNLOAD=1 forbids it
#
# To link an installed engine instead of compiling the copy, either
#
#   DSEAMS_SYSTEM_ENGINE=1  find libseams and libseams_lang with pkg-config
#                           (the seams and seams-lang modules), or
#   SEAMS_LIBDIR    the directory of libseams_lang, with SEAMS_INCLUDE the
#                   directory of seams_lang.h, SEAMS_H_DIR that of seams.h
#                   and SEAMS_SO_DIR that of libseams and seams_version.h.
#                   With DSEAMS_ROOT set to a seams-core checkout, the
#                   headers are found under it.
#
# The example data in inst/extdata come with the copy and are needed in
# every mode.

: "${R_HOME:=$(R RHOME)}"
if [ ! -x "${R_HOME}/bin/R" ]; then
  echo "configure: could not find R under R_HOME=${R_HOME}" >&2
  exit 1
fi

version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
if [ ! -f src/seams/seams_lang.cpp ] || [ ! -f inst/extdata/ice1h.lammpstrj ]; then
  if [ ! -f tools/vendor.sh ]; then
    echo "configure: src/seams is missing and there is no tools/vendor.sh to make it" >&2
    exit 1
  fi
  R_HOME=${R_HOME} sh tools/vendor.sh || exit 1
fi

link_mode=
case "${DSEAMS_SYSTEM_ENGINE:-}" in
  1|yes|true|TRUE) link_mode=pkg-config ;;
esac
if [ -n "${SEAMS_LIBDIR:-}" ]; then
  link_mode=libdir
fi

if [ "${link_mode}" = pkg-config ]; then
  PKG_CONFIG=${PKG_CONFIG:-pkg-config}
  if ! ${PKG_CONFIG} --exists seams-lang seams; then
    echo "configure: DSEAMS_SYSTEM_ENGINE is set, but ${PKG_CONFIG} finds no seams-lang and seams modules; set PKG_CONFIG_PATH" >&2
    exit 1
  fi
  have=$(${PKG_CONFIG} --modversion seams)
  if [ "${have}" != "${version}" ]; then
    echo "configure: the installed engine is ${have}; dseams ${version} needs seams-core ${version}" >&2
    exit 1
  fi
  libdir=$(${PKG_CONFIG} --variable=libdir seams)
  lang_libdir=$(${PKG_CONFIG} --variable=libdir seams-lang)
  echo "configure: linking the installed engine ${have} from ${libdir}"
  SEAMS_CPPFLAGS=$(${PKG_CONFIG} --cflags seams-lang seams)
  SEAMS_LIBS="$(${PKG_CONFIG} --libs seams-lang seams) -Wl,-rpath,${lang_libdir} -Wl,-rpath,${libdir}"
  OPENMP_CXXFLAGS=""
  ENGINE_OBJECTS=""
elif [ "${link_mode}" = libdir ]; then
  if [ -z "${SEAMS_INCLUDE:-}" ] && [ -n "${DSEAMS_ROOT:-}" ]; then
    SEAMS_INCLUDE="${DSEAMS_ROOT}/bindings/cxx"
  fi
  if [ -z "${SEAMS_INCLUDE:-}" ] || [ ! -f "${SEAMS_INCLUDE}/seams_lang.h" ]; then
    echo "configure: SEAMS_LIBDIR is set, but seams_lang.h is not in SEAMS_INCLUDE='${SEAMS_INCLUDE:-}'; set SEAMS_INCLUDE or DSEAMS_ROOT" >&2
    exit 1
  fi
  # seams_call.c binds include/seams.h. libseams and the generated
  # seams_version.h sit in src/ of the build that holds SEAMS_LIBDIR,
  # whatever that build directory is called.
  SEAMS_H_DIR="${SEAMS_H_DIR:-${DSEAMS_ROOT:+${DSEAMS_ROOT}/include}}"
  if [ -z "${SEAMS_H_DIR}" ] || [ ! -f "${SEAMS_H_DIR}/seams.h" ]; then
    echo "configure: SEAMS_LIBDIR is set, but seams.h is not in SEAMS_H_DIR='${SEAMS_H_DIR:-}'; set DSEAMS_ROOT or SEAMS_H_DIR" >&2
    exit 1
  fi
  SEAMS_SO_DIR="${SEAMS_SO_DIR:-}"
  for dir in \
    "${SEAMS_SO_DIR}" \
    "$(dirname "${SEAMS_LIBDIR}")/src" \
    "${SEAMS_LIBDIR}" \
    "${DSEAMS_ROOT:+${DSEAMS_ROOT}/build/src}"
  do
    if [ -n "${dir}" ] && [ -f "${dir}/seams_version.h" ]; then
      SEAMS_SO_DIR=$dir
      break
    fi
  done
  if [ -z "${SEAMS_SO_DIR}" ]; then
    echo "configure: no seams_version.h next to libseams; set SEAMS_SO_DIR to the build's src directory" >&2
    exit 1
  fi
  echo "configure: linking libseams_lang from ${SEAMS_LIBDIR} and libseams from ${SEAMS_SO_DIR}"
  SEAMS_CPPFLAGS="-I${SEAMS_INCLUDE} -I${SEAMS_H_DIR} -I${SEAMS_SO_DIR}"
  SEAMS_LIBS="-L${SEAMS_LIBDIR} -lseams_lang -L${SEAMS_SO_DIR} -lseams -Wl,-rpath,${SEAMS_LIBDIR} -Wl,-rpath,${SEAMS_SO_DIR}"
  OPENMP_CXXFLAGS=""
  ENGINE_OBJECTS=""
else
  SEAMS_CPPFLAGS="-I. -Iseams -Iseams/include -DSEAMS_STATIC -DSEAMS_LANG_VERSION='\"${version}\"'"
  SEAMS_LIBS=""
  ENGINE_OBJECTS='$(SEAMS_OBJECTS)'
  # An empty SHLIB_OPENMP_CXXFLAGS (Apple clang, for one) builds the
  # engine loops single-threaded.
  openmp=$(sed -n 's/^SHLIB_OPENMP_CXXFLAGS[[:space:]]*=[[:space:]]*//p' \
    "${R_HOME}/etc${R_ARCH}/Makeconf")
  if [ -n "${openmp}" ]; then
    echo "configure: OpenMP via ${openmp}"
    SEAMS_CPPFLAGS="${SEAMS_CPPFLAGS} -DSEAMS_HAS_OPENMP=1"
    OPENMP_CXXFLAGS='$(SHLIB_OPENMP_CXXFLAGS)'
  else
    echo "configure: no OpenMP; the engine runs single-threaded"
    OPENMP_CXXFLAGS=""
  fi
fi

# Optional readers. Neither library is required. A CRAN machine has
# neither, and the engine then reads LAMMPS dumps and XYZ only.
if [ -z "$link_mode" ]; then
  reader_mode=bundled
else
  reader_mode=linked
fi
reader_eval=$(R_HOME="$R_HOME" \
  SEAMS_SO_DIR="${SEAMS_SO_DIR:-}" \
  SEAMS_LIBDIR="${SEAMS_LIBDIR:-}" \
  SEAMS_SCAN_DIR="${libdir:-}" \
  SEAMS_CPPFLAGS="$SEAMS_CPPFLAGS" \
  sh tools/find-readers.sh "$reader_mode") || exit 1
eval "$reader_eval"
if [ -n "$dseams_reader_cppflags" ]; then
  SEAMS_CPPFLAGS="$SEAMS_CPPFLAGS $dseams_reader_cppflags"
fi
if [ -n "$dseams_reader_libs" ]; then
  SEAMS_LIBS="$SEAMS_LIBS $dseams_reader_libs"
fi
echo "configure: $dseams_reader_message"

sed -e "s|@SEAMS_CPPFLAGS@|${SEAMS_CPPFLAGS}|" \
  -e "s|@SEAMS_LIBS@|${SEAMS_LIBS}|" \
  -e "s|@OPENMP_CXXFLAGS@|${OPENMP_CXXFLAGS}|g" \
  -e "s|@ENGINE_OBJECTS@|${ENGINE_OBJECTS}|" \
  src/Makevars.in > src/Makevars
